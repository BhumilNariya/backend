<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full h-screen  bg-zinc-900 p-8 text-white">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 block mb-5 text-sm inline-block  " href="/logout">Logout</a>
        </div>
        <h5 class="mb-5 text-3xl"> Edit Your Post</h5>
        <form action="/update/<%= post._id %>" method="post">
            <textarea class="resize-none w-1/3 bg-transparent block border-2 border-zinc-800 rounded-md p-3 outline-none " placeholder="what's in your mind" name="content" ><%= post.content %></textarea>
            <input  class="px-3 py-2 bg-yellow-500 rounded-md block mt-2" type="submit" value="update post">
        </form>

       
        
    </div>
</body>
</html>