<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <h3 class="text-3xl  mb-5">Login Your Account</h3>
        <form action="/login" method="post">
            <input type="email" class="px-3 py-2 outline-none border-2 border-zinc-700  rounded-md bg-transparent" placeholder="email" name="email">
            <input type="password"  class="px-3 py-2 outline-none border-2 border-zinc-700  rounded-md bg-transparent" placeholder="password" name="password">
            <input type="submit" class="px-3 py-2 bg-yellow-500 rounded-md" value="Login">
        </form>
    </div>
</body>
</html>