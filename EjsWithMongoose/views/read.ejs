<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body class="bg-zinc-900 p-10">
    <div class="nav mb-10">
            <a class="bg-blue-500 px-3 py-2 rounded-md tracking-tighter " href="/">Go To Home</a>
        </div>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <h1 class="text-3xl tracking-tighter mb-3">All User</h1>
        <div class="users  flex gap-3 flex-wrap">
            <% users.forEach(function(user){ %>
                    <div class="user max-w-72  p-4 bg-zinc-800 rounded-lg">
                <div class="w-full h-52 rounded-lg bg-zinc-700 overflow-hidden">
                    <img class="w-full h-full  object-cover " src="<%= user.image %>" alt="">
                </div>
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %> </h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>
                    <div class="flex gap-3 mt-10">
                        <a  class="text-yellow-200" href="/edit/<%= user._id %>">Edit User</a>
                        <a  class="text-red-500" href="/delete/<%=user._id %>">Delete User</a>
                    </div>
            </div>
            <%}) %>     
        </div>
    </div>
</body>
</html>